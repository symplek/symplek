/**
 * {{name}} Agent
 * TypeScript agent definition
 * Created with: weft add agent {{name}} --type typescript
 *
 * Call Weft.configure({ apiKey, model }) before using this agent.
 * See: https://weft.dev/docs/configuration
 */
import { AgentUnit, createContext } from "weft-core";
import { ai } from "weft-core/server";

/**
 * Run the {{name}} agent with a prompt.
 * Returns an AgentUnit<string> — chain operators (.retry, .timeout, …) before calling .run().
 */
export function {{agentName}}(prompt: string): AgentUnit<string> {
  return AgentUnit.from((_ctx) =>
    ai(prompt, {
      model: "{{model}}",
      system: `You are {{name}}, a helpful AI assistant.

Your responsibilities:
- Answer questions clearly and accurately
- Provide helpful explanations

Be concise, accurate, and friendly.`,
    }),
  );
}

export type AgentResult = Awaited<ReturnType<ReturnType<typeof {{agentName}}>["run"]>>;

/**
 * Convenience helper: run the agent and return its string value.
 */
export async function run(prompt: string): Promise<string> {
  const ctx = createContext();
  const result = await {{agentName}}(prompt).run(ctx);
  return result.value as string;
}
