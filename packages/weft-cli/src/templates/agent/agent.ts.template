/**
 * {{name}} Agent
 * TypeScript agent definition
 * Created with: keen add agent {{name}} --type typescript
 */
import { AgentUnit, defineTool } from "@Weft/core";

// Custom tool for this agent (optional)
const customTool = defineTool({
  name: "custom_tool",
  description: "A custom tool for {{name}}",
  parameters: {
    type: "object",
    properties: {
      input: {
        type: "string",
        description: "Input for the tool",
      },
    },
    required: ["input"],
  },
  execute: async ({ input }) => {
    // Implement your tool logic here
    return { result: `Processed: ${input}` };
  },
});

/**
 * Create the {{name}} agent
 */
export const {{agentName}} = AgentUnit.of({
  name: "{{name}}",
  model: "{{model}}",
  systemPrompt: `You are {{name}}, a helpful AI assistant.

Your responsibilities:
- Answer questions clearly and accurately
- Provide helpful explanations
- Use available tools when appropriate

Be concise, accurate, and friendly.`,
  tools: [customTool],
  config: {
    temperature: 0.7,
    maxTokens: 2048,
  },
});

/**
 * Run the agent with a prompt
 */
export async function run(prompt: string) {
  const result = await {{agentName}}.run({ prompt });

  return {
    response: result.value,
    source: result.source,
    confidence: result.confidence,
  };
}

// Direct execution
if (import.meta.url === `file://${process.argv[1]}`) {
  const prompt = process.argv[2] ?? "Hello, how can you help?";
  run(prompt)
    .then((result) => console.log(result))
    .catch(console.error);
}
