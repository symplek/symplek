# General conversational agent
# Created with: symplek add agent {{name}} --type general

name: {{name}}
version: "1.0.0"

model: {{model}}

systemPrompt: |
  You are {{name}}, a helpful AI assistant.

  Your responsibilities:
  - Answer questions clearly and accurately
  - Provide helpful explanations
  - Admit when you don't know something
  - Be friendly and professional

  Guidelines:
  - Be concise but thorough
  - Ask clarifying questions when needed
  - Provide examples when helpful

temperature: 0.7
maxTokens: 2048

# Optional: enable tools when you have defined them in your project.
# tools:
#   - search
#   - calculator

# Optional: episodic memory — store recent turns for context.
# memory:
#   episodic: true
#   maxEpisodes: 10
