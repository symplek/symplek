# {{name}} — Symplek agent runtime image.
#
# Multi-stage build:
#   1. Install all deps + compile TypeScript to dist/.
#   2. Ship a slim runtime image with only production deps + dist/.
#
# Build:   docker build -t {{name}} .
# Run:     docker run --rm -e OPENAI_API_KEY=$OPENAI_API_KEY {{name}}

# ─── Stage 1: build ──────────────────────────────────────────────────────────
FROM node:20-alpine AS build
WORKDIR /app
RUN corepack enable

# Copy lockfile if present (won't fail if it's missing).
COPY package.json ./
COPY pnpm-lock.yaml* ./

RUN pnpm install

COPY tsconfig.json ./
COPY src ./src
COPY agents ./agents

RUN pnpm build

# ─── Stage 2: runtime ────────────────────────────────────────────────────────
FROM node:20-alpine
WORKDIR /app
RUN corepack enable && adduser -D -u 1001 symplek

COPY package.json ./
COPY pnpm-lock.yaml* ./

RUN pnpm install --prod

COPY --from=build /app/dist ./dist
COPY --from=build /app/agents ./agents

USER symplek
ENV NODE_ENV=production

CMD ["node", "dist/src/index.js"]
