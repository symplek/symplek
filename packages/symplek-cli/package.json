{
  "name": "@symplek/cli",
  "version": "0.1.0",
  "description": "Symplek CLI - AI Agent Development Toolkit",
  "license": "MIT",
  "bin": {
    "symplek": "./bin/symplek.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "bin",
    "dist",
    "CHANGELOG.md"
  ],
  "keywords": [
    "ai",
    "agents",
    "cli",
    "Symplek",
    "scaffolding"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/symplek/symplek.git",
    "directory": "packages/symplek-cli"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-templates.mjs",
    "dev": "tsc --watch",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "ajv": "^8.17.0",
    "chokidar": "^3.6.0",
    "commander": "^12.1.0",
    "inquirer": "^9.3.0",
    "chalk": "^5.3.0",
    "ora": "^8.0.1",
    "js-yaml": "^4.1.0",
    "glob": "^10.4.0"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.7",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.11.0",
    "typescript": "^5.5.0",
    "vitest": "^4.0.17",
    "@symplek/core": "workspace:*"
  },
  "peerDependencies": {
    "@symplek/core": ">=1.0.0-beta.1"
  },
  "engines": {
    "node": ">=20.19"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
