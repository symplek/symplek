{
  "name": "weft-core",
  "version": "1.0.0-beta.1",
  "description": "Composable AI agents for TypeScript",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "require": "./dist/server.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "keywords": [
    "ai",
    "agents",
    "multi-agent",
    "consensus",
    "llm",
    "typescript",
    "orchestration",
    "openai",
    "anthropic",
    "streaming"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/wefthq/weft.git",
    "directory": "packages/weft-core"
  },
  "bugs": {
    "url": "https://github.com/wefthq/weft/issues"
  },
  "homepage": "https://github.com/wefthq/weft#readme",
  "scripts": {
    "build": "tsup src/index.ts src/server.ts --format cjs,esm --dts --outDir dist",
    "dev": "tsup src/index.ts src/server.ts --format cjs,esm --watch --dts --outDir dist",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "typecheck:boundary": "tsc --noEmit -p tsconfig.boundary.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:contract": "vitest run src/__tests__/contractSmoke.test.ts src/__tests__/serverContractSmoke.test.ts",
    "test:golden": "vitest run src/__tests__/golden-path.test.ts",
    "test:size": "size-limit",
    "typecheck:change-kernel": "tsc --noEmit -p tsconfig.change-kernel.json"
  },
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "25 KB"
    },
    {
      "path": "dist/server.js",
      "limit": "40 KB"
    }
  ],
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.78.0",
    "@google/generative-ai": ">=0.24.0",
    "@opentelemetry/api": ">=1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": ">=0.200.0",
    "@opentelemetry/resources": ">=2.0.0",
    "@opentelemetry/sdk-trace-node": ">=2.0.0",
    "openai": ">=4.0.0",
    "zod": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    },
    "@opentelemetry/exporter-trace-otlp-http": {
      "optional": true
    },
    "@opentelemetry/resources": {
      "optional": true
    },
    "@opentelemetry/sdk-trace-node": {
      "optional": true
    },
    "zod": {
      "optional": true
    },
    "openai": {
      "optional": true
    },
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "@google/generative-ai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@google/generative-ai": "^0.24.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.219.0",
    "@opentelemetry/resources": "^2.8.0",
    "@opentelemetry/sdk-trace-base": "^2.8.0",
    "@opentelemetry/sdk-trace-node": "^2.8.0",
    "@size-limit/preset-small-lib": "^11.0.0",
    "@types/node": "^22.14.0",
    "size-limit": "^11.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.17",
    "zod": "^3.24.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
