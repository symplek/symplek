{
  "name": "weft-harness",
  "version": "0.1.0-alpha.1",
  "description": "Algebraic trust layer for Claude Agent SDK and OpenAI Agents SDK",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./replay": {
      "types": "./dist/replay/index.d.ts",
      "import": "./dist/replay/index.js"
    },
    "./react": {
      "types": "./dist/react/useHarnessProgress.d.ts",
      "import": "./dist/react/useHarnessProgress.js"
    }
  },
  "peerDependencies": {
    "weft-core": "^1.0.0-beta",
    "@anthropic-ai/claude-agent-sdk": ">=0.2.0",
    "openai": "^4.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/claude-agent-sdk": {
      "optional": true
    },
    "openai": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "*",
    "@types/react": "^18.0.0",
    "weft-core": "workspace:*",
    "typescript": "^5.0.0",
    "vitest": "^4.0.17"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run"
  }
}
