{
  "name": "@symplek/harness",
  "version": "0.1.0-alpha.1",
  "description": "Plan, permission-gate and execute operators for agent sessions. Pre-alpha and ESM only: no agent SDK is wired yet, so every result is a stand-in",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/symplek/symplek.git",
    "directory": "packages/symplek-harness"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./replay": {
      "types": "./dist/replay/index.d.ts",
      "import": "./dist/replay/index.js"
    },
    "./react": {
      "types": "./dist/react/useHarnessProgress.d.ts",
      "import": "./dist/react/useHarnessProgress.js"
    }
  },
  "peerDependencies": {
    "@symplek/core": "^1.0.0-beta",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "*",
    "@types/react": "^18.0.0",
    "@symplek/core": "workspace:*",
    "typescript": "^5.0.0",
    "vitest": "^4.0.17"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  }
}
