{
  "name": "create-symplek",
  "version": "0.2.0-beta.0",
  "private": true,
  "description": "Scaffold a Symplek agent project: a thin wrapper around `symplek init` from @symplek/cli.",
  "license": "MIT",
  "bin": {
    "create-symplek": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "ai",
    "agents",
    "Symplek",
    "scaffolding",
    "create"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/symplek/symplek.git",
    "directory": "packages/create-symplek"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs --outDir dist",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@symplek/cli": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20.19"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
