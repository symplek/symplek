{
  "name": "@symplek/convex",
  "version": "0.1.0",
  "description": "Symplek Framework — Convex integration for AI agent actions",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --watch --dts",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "typecheck:boundary": "tsc --noEmit -p tsconfig.boundary.json",
    "test:contract": "vitest run src/__tests__/contractSmoke.test.ts",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@symplek/core": "workspace:*",
    "convex": "^1.19.0",
    "zod": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "convex": "^1.19.0",
    "tsup": "^8.4.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.17"
  },
  "keywords": [
    "ai",
    "agents",
    "convex",
    "symplek",
    "multi-agent"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/symplek/symplek.git",
    "directory": "packages/symplek-convex"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
