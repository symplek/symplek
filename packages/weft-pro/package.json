{
  "name": "@weft/pro",
  "version": "1.0.0-beta.1",
  "description": "Advanced multi-agent coordination for Weft — TaCo consensus, teams, solo gate, rehearsal",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "license": "BUSL-1.1",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "keywords": [
    "ai",
    "agents",
    "multi-agent",
    "consensus",
    "enterprise",
    "observability",
    "testing",
    "coordination"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/wefthq/weft.git",
    "directory": "packages/weft-pro"
  },
  "bugs": {
    "url": "https://github.com/wefthq/weft/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --outDir dist",
    "dev": "tsup src/index.ts --format cjs,esm --watch --dts",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "typecheck:boundary": "tsc --noEmit -p tsconfig.boundary.json",
    "test:contract": "vitest run src/__tests__/contractSmoke.test.ts"
  },
  "peerDependencies": {
    "@weft/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "tsup": "^8.4.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.17",
    "zod": "^3.24.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
