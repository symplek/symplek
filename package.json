{
  "name": "symplek-workspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Symplek — composable AI agents for TypeScript. Workspace root.",
  "scripts": {
    "build": "pnpm --filter \"@symplek/*\" --filter \"create-symplek\" run build",
    "test": "pnpm --filter \"@symplek/*\" run test",
    "lint": "pnpm --filter \"@symplek/*\" --filter \"create-symplek\" run lint",
    "typecheck": "pnpm --filter \"@symplek/*\" --filter \"create-symplek\" run typecheck",
    "check:versions": "node scripts/sync-versions.mjs --check",
    "check:docs": "node scripts/check-readme-imports.mjs",
    "check:consumer": "node scripts/consumer-smoke.mjs",
    "check:scaffold": "node scripts/scaffold-e2e.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version && node scripts/sync-versions.mjs",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@changesets/cli": "^2.27.0"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20"
  }
}
